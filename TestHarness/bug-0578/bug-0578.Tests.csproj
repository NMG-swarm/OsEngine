<Project Sdk="Microsoft.NET.Sdk">

  <!-- BUG-0577 / bug-0578 юнит-тесты маппинга steps (ТЗ, review-20261121-014, ОдТС plan-20261121-018).
       Листинг харнесса для зачёта покрытия; канонический рантайм — у агента-владельца, в PR фикса не входит.
       EngineProject по умолчанию — OsEngine.csproj этого же checkout; переопределение: -p:EngineProject=<путь>. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <AssemblyName>bug0578-tests</AssemblyName>
    <RootNamespace>Bug0578Tests</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EngineProject Condition="'$(EngineProject)' == ''">$(MSBuildThisFileDirectory)..\..\project\OsEngine\OsEngine.csproj</EngineProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(EngineProject)" />
  </ItemGroup>

</Project>
