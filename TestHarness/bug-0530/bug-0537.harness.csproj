<Project Sdk="Microsoft.NET.Sdk">

  <!-- bug-0537 (BUG-0529): юнит-харнесс маппинга анкетных полей ISS MoexDataServer.
       Reflection-only, без ProjectReference/NuGet: OsEngine.dll подгружается из bin клона. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>bug-0537.harness</AssemblyName>
    <RootNamespace>Bug0537Harness</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
